# Use the direct (unpooled) connection string for the Neon project's default
# branch. Database maintenance must not use Neon's pooled application URL.
#
# WARNING: db:reset:staging destroys the configured database's application and
# migration schemas without checking the hostname or branch and without asking
# for confirmation. Verify the private URL in .env.staging.local before use.
DATABASE_URL=postgresql://owner:replace-me@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require
