# Use the pooled application connection string for the Neon project's default
# branch. The hostname usually contains "-pooler". Keep the direct connection
# string in the root .env.staging.local file for database maintenance only.
DATABASE_URL=postgresql://owner:replace-me@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# The locally running web application continues to call this local API.
API_ALLOWED_ORIGINS=http://localhost:3000
API_PORT=3001

# These optional staging-local overrides match the application defaults.
API_DATABASE_CONNECTION_TIMEOUT_MS=5000
API_DATABASE_STATEMENT_TIMEOUT_MS=10000
