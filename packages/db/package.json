{
  "name": "@workspace/db",
  "type": "module",
  "private": true,
  "browser": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env.local --import tsx src/cli/migrate.ts",
    "db:reset": "node --env-file-if-exists=../../.env.local --import tsx src/cli/reset.ts",
    "db:seed": "node --env-file-if-exists=../../.env.local --import tsx src/cli/seed.ts",
    "format": "prettier --write \"**/*.{ts,json}\"",
    "lint": "eslint",
    "test": "vitest run src/database-url.test.ts src/reset.test.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "latest",
    "@types/node": "^22",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9",
    "prettier": "^3.8.4",
    "tsx": "^4.21.0",
    "typescript": "^6",
    "vitest": "^5.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  }
}
