{
  "extends": "../../tsconfig.json",
  "include": [
    "src/**/*.ts",
    "drizzle.config.ts",
    "vitest.integration.config.ts"
  ],
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node", "vitest/globals"]
  }
}
